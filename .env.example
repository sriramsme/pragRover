# Copy to .env and fill only what you use. Never commit .env.
# Offline simulation needs none of these.

# Match the secrets provisioned on your own boards.
# Motion: 16–128 characters. Camera: 24–240 visible ASCII, no spaces.
# PRAG_ROVER_TOKEN=
# PRAG_CAMERA_TOKEN=

# Optional hosted inference. Calls require explicit CLI opt-in.
# OPENAI_API_KEY=
# TYPESAFE_API_KEY=
